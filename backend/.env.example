NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Replace placeholders. Never commit real connection strings or secrets.
DATABASE_URL=postgresql://authvault:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:55432/authvault
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUDIT_HMAC_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
PENDING_TTL_SECONDS=600
# Optional, separate isolated test database (never point tests at application data).
TEST_DATABASE_URL=postgresql://authvault:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:55432/authvault_test
# Generate each independently; use a secret manager in production.
OTP_HMAC_KEY=REPLACE_WITH_INDEPENDENT_64_RANDOM_HEX_CHARACTERS
ACCESS_JWT_KEY=REPLACE_WITH_ANOTHER_INDEPENDENT_64_RANDOM_HEX_SECRET
OTP_RESEND_SECONDS=60
# Loopback development mailbox (or Mailpit). No SMTP auth on this local test server.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="AuthVault <security@authvault.local>"
SMTP_SECURE=false
# Production: provider hostname/port, TLS (required in production), credentials.
# SMTP_USER=PROVIDER_USERNAME
# SMTP_PASSWORD=PROVIDER_PASSWORD_FROM_SECRET_MANAGER
