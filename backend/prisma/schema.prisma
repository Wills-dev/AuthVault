generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MfaStage {
  PENDING_ENROLMENT
  ENROLMENT_COMPLETE
  PENDING_BIOMETRIC
  PENDING_OTP
  COMPLETED
  REVOKED
}

model User {
  id             String                @id @default(uuid()) @db.Uuid
  email          String                @unique @db.VarChar(254)
  fullName       String                @db.VarChar(100)
  otpLockedUntil DateTime?
  passwordHash   String
  createdAt      DateTime              @default(now())
  attempts       AuthAttempt[]
  credentials    BiometricCredential[]
  sessions       AuthSession[]
  events         AuditEvent[]
}

model AuthAttempt {
  id                   String               @id @default(uuid()) @db.Uuid
  userId               String               @db.Uuid
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash            String               @unique @db.Char(64)
  stage                MfaStage
  expiresAt            DateTime
  createdAt            DateTime             @default(now())
  verifiedCredentialId String?              @db.Uuid
  otpChallenges        OtpChallenge[]
  biometricChallenges  BiometricChallenge[]

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// Public credentials only; private key material never reaches this database.
model BiometricCredential {
  id         String               @id @default(uuid()) @db.Uuid
  userId     String               @db.Uuid
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String               @db.VarChar(128)
  publicKey  String
  createdAt  DateTime             @default(now())
  revokedAt  DateTime?
  challenges BiometricChallenge[]

  @@unique([userId, deviceId])
}

// HMAC only. Plaintext codes exist solely during SMTP submission.
model OtpChallenge {
  id            String      @id @default(uuid()) @db.Uuid
  attemptId     String      @db.Uuid
  attempt       AuthAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  codeMac       String      @db.Char(64)
  expiresAt     DateTime
  consumedAt    DateTime?
  resendAt      DateTime    @default(now())
  invalidatedAt DateTime?
  failures      Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([attemptId, createdAt])
  @@index([expiresAt])
}

// Live database authorization makes revocation effective for subsequent requests.
model AuthSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  attemptId     String?        @unique @db.Uuid
  credentialId  String?        @db.Uuid
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
}

model RefreshToken {
  id         String      @id @default(uuid()) @db.Uuid
  sessionId  String      @db.Uuid
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash  String      @unique @db.Char(64)
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime    @default(now())

  @@index([sessionId])
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind        String   @db.VarChar(50)
  subjectHash String?  @db.Char(64)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model RateLimit {
  key       String   @id @db.Char(64)
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

enum BiometricPurpose {
  ENROLMENT
  LOGIN
}

model BiometricChallenge {
  id                     String               @id @default(uuid()) @db.Uuid
  attemptId              String               @db.Uuid
  attempt                AuthAttempt          @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  purpose                BiometricPurpose
  credentialId           String               @db.Uuid
  // Login has a credential FK; enrolment is tied to a proposed key fingerprint.
  registeredCredentialId String?              @db.Uuid
  registeredCredential   BiometricCredential? @relation(fields: [registeredCredentialId], references: [id], onDelete: Cascade)
  publicKeyHash          String               @db.Char(64)
  publicKey              String?
  payload                String               @db.VarChar(2048)
  expiresAt              DateTime
  consumedAt             DateTime?
  createdAt              DateTime             @default(now())

  @@index([attemptId, purpose, createdAt])
  @@index([expiresAt])
}
