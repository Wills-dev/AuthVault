{
  "name": "authvault-backend",
  "version": "0.3.0",
  "description": "AuthVault password, biometric and email OTP authentication with rotating sessions",
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/main.js",
    "dev": "npm run build && npm start",
    "format": "prettier --write src test scripts *.json *.ts *.mjs *.cjs && prisma format",
    "format:check": "prettier --check src test scripts *.json *.ts *.mjs *.cjs",
    "lint": "eslint src test",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathPatterns=unit",
    "test:integration": "node scripts/test-integration.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:local": "node scripts/local-db.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.9",
    "helmet": "8.3.0",
    "jose": "6.2.14",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "smtp-server": "3.21.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
